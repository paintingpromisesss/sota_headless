[Unit]
Description=Sota Headless Subscription Provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/sota-headless/sota-headless.env
WorkingDirectory=/etc/sota-headless
ExecStart=/usr/bin/sota-headless
Restart=always
RestartSec=5
LimitNOFILE=65535

# Resource protection
MemoryMax=64M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
