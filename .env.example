# Sota Headless — Subscription Provider
# Copy to .env and fill in SOTA_ACCESS_KEY

# === REQUIRED ===
SOTA_ACCESS_KEY=PUT_YOUR_SOTA_ACCESS_KEY_HERE

# === HTTP Server ===
# 0.0.0.0 = listen on all interfaces (needed for router access from LAN)
# Change to 127.0.0.1 if running on a PC and want local-only access
SOTA_LISTEN=0.0.0.0:16698

# Always enabled — this is now a subscription server only
SOTA_API_ENABLED=true

# === Subscription cache ===
# How long to cache fetched nodes before re-querying Sota API
# Valid units: s, m, h. Default: 30m
SOTA_CACHE_TTL=30m

# === API base URLs (optional, defaults below) ===
# SOTA_API_BASES=https://meowconnect.com/api/v1,https://sota.ac/api/v1

# === Identity (optional, auto-generated on first run) ===
# SOTA_HWID=
# SOTA_DEVICE_NAME=
# SOTA_USER_AGENT=Sota Connect (v1.7.7/windows)
# SOTA_ACCEPT_LANGUAGE=ru

# === Log level (optional) ===
# SOTA_LOG_LEVEL=info
